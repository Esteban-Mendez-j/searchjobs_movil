# Copia este archivo a ".env" (el .env real no se sube a git).
# ENV=prod usa el backend real; ENV=mock usa el servidor mock de Postman.
ENV=prod

# Backend local: con Chrome o con "adb reverse tcp:8080 tcp:8080" en un celular.
# Si el backend esta desplegado, pon aqui su URL https://...
PROD_URL=http://localhost:8080
